+/* CFG: the seat nginx wrote on the upgrade request, from the platform edge's identity header.
+ * 0 when there is none, or it is not a number from 1 to 4294967295.
+ */
+static unsigned long request_seat(const char *request)
+{
+	const char *end, *p;
+	unsigned long seat = 0;
+
+	if ((end = strstr(request, "\r\n\r\n")) == NULL)
+		return (0);
+	if (((p = strstr(request, "\r\nX-Cfg-Seat: ")) == NULL) || (p > end))
+		return (0);
+	for (p += 14; (*p >= '0') && (*p <= '9'); p++)
+	{
+		seat = (seat * 10) + (unsigned long)(*p - '0');
+		if (seat > 4294967295UL)
+			return (0);
+	}
+	return ((*p == '\r') ? seat : 0);
+}
+
+/* CFG: end every socket opened for @p seat, and return how many. Each is shut down, never closed
+ * here: its own thread wakes from recv() and leaves through its usual close path, which unlinks it
+ * from its group and closes the number. The closing thread clears client_sock under this same
+ * mutex before it closes, so a number read here is still that socket's.
+ */
+int ws_drop_seat(unsigned long seat)
+{
+	int i, dropped = 0;
+
+	if (seat == 0)
+		return (0);
+
+	pthread_mutex_lock(&mutex);
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if ((client_socks[i].client_sock == -1) || (client_socks[i].seat != seat))
+			continue;
+		if (shutdown(client_socks[i].client_sock, SHUT_RDWR) == 0)
+			dropped++;
+	}
+	pthread_mutex_unlock(&mutex);
+
+	return (dropped);
+}
