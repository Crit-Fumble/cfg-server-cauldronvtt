 static FILE *logfile = NULL;
 
+/* CFG: where the platform's drop-seat route (cfg-drop-seat.php) reaches the daemon. Its directory
+ * is the container's own, mode 0700, so only the uid nginx and php-fpm run as can connect.
+ */
+#define CONTROL_SOCKET "/tmp/cauldron/cauldrond.sock"
+
+static int control_listen(void)
+{
+	struct sockaddr_un addr;
+	int sock;
+
+	if ((sock = socket(AF_UNIX, SOCK_STREAM, 0)) == -1)
+		return -1;
+	memset(&addr, 0, sizeof(addr));
+	addr.sun_family = AF_UNIX;
+	strncpy(addr.sun_path, CONTROL_SOCKET, sizeof(addr.sun_path) - 1);
+	unlink(CONTROL_SOCKET);
+	if ((bind(sock, (struct sockaddr *)&addr, sizeof(addr)) == -1) || (listen(sock, 8) == -1)) {
+		close(sock);
+		return -1;
+	}
+
+	return sock;
+}
+
+/* One command a connection, "drop <seat>\n", answered with how many sockets it ended, or -1 for a
+ * command it does not take.
+ */
+static void *control_loop(void *data)
+{
+	struct timeval timeout = { 2, 0 };
+	int sock = (int)(intptr_t)data, client, dropped, n;
+	unsigned long seat;
+	char line[32], *end;
+
+	for (;;) {
+		if ((client = accept(sock, NULL, NULL)) == -1) {
+			sleep(1);
+			continue;
+		}
+		setsockopt(client, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+
+		dropped = -1;
+		if ((n = (int)recv(client, line, sizeof(line) - 1, 0)) > 0) {
+			line[n] = '\0';
+			if ((strncmp(line, "drop ", 5) == 0) && (line[5] >= '1') && (line[5] <= '9')) {
+				seat = strtoul(line + 5, &end, 10);
+				if ((*end == '\n') && (seat <= 4294967295UL))
+					dropped = ws_drop_seat(seat);
+			}
+		}
+
+		n = snprintf(line, sizeof(line), "%d\n", dropped);
+		send(client, line, (size_t)n, MSG_NOSIGNAL);
+		close(client);
+	}
+
+	return NULL;
+}
